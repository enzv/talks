@@ -0,0 +1,13 @@
+import { Controller, HttpCode, Post } from '@nestjs/common';
+import { CheckoutService } from './checkout.service';
+
+@Controller('checkout')
+export class CheckoutController {
+  constructor(private readonly checkoutService: CheckoutService) {}
+
+  @Post()
+  @HttpCode(200)
+  checkout() {
+    return this.checkoutService.checkout();
+  }
+}
diff --git a/packages/app/src/app/checkout/checkout.service.ts b/packages/app/src/app/checkout/checkout.service.ts
new file mode 100644
index 0000000000000000000000000000000000000000..1ad8ba32ad41ad128574acf6ff6cc00d57ccca9b
--- /dev/null
+++ b/packages/app/src/app/checkout/checkout.service.ts
@@ -0,0 +1,42 @@
+import { Injectable, ServiceUnavailableException } from '@nestjs/common';
+import { Client, OpenFeatureClient } from '@openfeature/nestjs-sdk';
+
+@Injectable()
+export class CheckoutService {
+  private v2StartedAt?: number;
+
+  constructor(@OpenFeatureClient() private readonly client: Client) {}
+
+  async checkout() {
+    const useV2 = await this.client.getBooleanValue('checkout-v2', false);
+
+    if (useV2) {
+      return this.newCheckout();
+    }
+
+    this.v2StartedAt = undefined;
+    return this.stableCheckout();
+  }
+
+  private async stableCheckout() {
+    await this.sleep(700);
+    return { status: 'paid', checkout: 'stable' };
+  }
+
+  private async newCheckout() {
+    this.v2StartedAt ??= Date.now();
+    const runningFor = Date.now() - this.v2StartedAt;
+    await this.sleep(150);
+
+    // Demo only: after five healthy seconds, simulate intermittent dependency failures.
+    if (runningFor >= 5000 && Math.random() < 0.4) {
+      throw new ServiceUnavailableException('Checkout V2 dependency unavailable');
+    }
+
+    return { status: 'paid', checkout: 'v2' };
+  }
+
+  private sleep(ms: number) {
+    return new Promise((resolve) => setTimeout(resolve, ms));
+  }
+}
